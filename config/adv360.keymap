            label = "MK";
        };

        ml: ml {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp L>;
            label = "ML";
        };

        msemco: msemco {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp SEMI>;
            label = "MSEMCO";
        };

        mn: mn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp N>;
            label = "MN";
        };

        mcomma: mcomma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp COMMA>;
            label = "MCOMMA";
        };

        mdot: mdot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
